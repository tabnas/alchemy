; The declarative transducer: a tree's JSON events from a grammar's rule
; passes (ParserEvents/1), as a spec keyed by rule name says, so that a
; transducer part for a grammar whose rules map onto a tree writes no
; state machine of its own. The json grammar's part is
;
;   def json-transduce [input]
;     transduce-tree
;       record
;         entry :map (record (entry :container :object))
;         entry :list (record (entry :container :array))
;         entry :pair (record (entry :key 0))
;         entry :val (record (entry :scalar 0))
;       input
;
; Each entry is a record of what that rule's passes do, any of:
; `:container`, `:object` or `:array`, which the rule's open pass begins
; and its close pass ends; `:key`, the member name its open pass
; announces, a token's index (that token's `:val` names the member) or a
; string; `:scalar`, the scalar the rule yields, a token's index (that
; token of its open pass, when the pass consumed one: its `:val`, with
; the lexeme a number token carries) or `:value` (its close pass's own
; value); `:member`, a member name its open pass announces after what it
; begins or yields, read as `:key` is, so that a container rule can name
; the first member of its own container; and `:text`, `true` for a rule
; whose close pass yields, before anything else, the text that the
; passes between its open pass and its close pass consumed: each token's
; `:src`, in order, which is the source text a grammar's tree builders
; gather for a rule's node. An open pass announces its key before it
; begins its container or yields its scalar, and its member after. A
; pass of a rule the spec does not name yields nothing. A container
; whose rule is replaced by a rule the spec names a container (its close
; pass's alternate replaces it) is one container: that close yields no
; end and the replacing open no start.
;
; transduce-step's state is [stack carry]: one :open marker per open
; container, and whether a container's close handed it on to the rule
; replacing it. It reads neither `:member` nor `:text`. transduce-tree's
; step is transduce-pass, over the state [[stack carry] texts]: the same
; two, and the text each open `:text` rule has gathered so far, the
; innermost last, which joins the text around it when its rule closes.
; Nothing grows with the document's width or length, only with its
; nesting and with the text of a `:text` rule still open.

; Token `n` of a pass, or missing when it consumed no such token.
def transduce-token [n rule]
  get-path (path n) (get :tokens rule)

; The outputs with the member `name` names after them: a string as it
; stands, or the `:val` of the pass's token at that index; nothing when
; `name` is missing or the pass consumed no such token.
def transduce-named [name rule outputs]
  match name
    case missing outputs
    case name
      match (kind name)
        case :string (push (key name) outputs)
        case _
          match (transduce-token name rule)
            case missing outputs
            case token (push (key (get :val token)) outputs)

; The outputs with the key an open pass announces after them.
def transduce-key [entry rule outputs]
  transduce-named (get :key entry) rule outputs

; The outputs with the scalar an open pass yields from one of its tokens.
def transduce-scalar [from rule outputs]
  match (kind from)
    case :number
      match (transduce-token from rule)
        case missing outputs
        case token (push (scalar (get :val token)) outputs)
    case _ outputs

; The outputs with the scalar a close pass yields from its own value.
def transduce-value [from rule outputs]
  match from
    case :value
      match (get :value rule)
        case missing outputs
        case value (push (scalar value) outputs)
    case _ outputs

; A container begins, unless the rule it replaced carries it on.
def transduce-begin [state start outputs]
  match state
    case [stack true] (transition [stack false] outputs)
    case [stack carry] (transition [(push :open stack) false] (push start outputs))

; A container ends, unless the alternate replaces its rule with a rule the
; spec names a container, which carries it on.
def transduce-end [spec state rule end]
  match state
    case [stack carry]
      match (get :alt rule)
        case missing (transition [(pop stack) false] [end])
        case alt
          match (get (get :r alt) spec)
            case missing (transition [(pop stack) false] [end])
            case next
              match (get :container next)
                case missing (transition [(pop stack) false] [end])
                case _ (transition [stack true] [])

def transduce-open [spec state rule]
  match (get (get :name rule) spec)
    case missing (transition state [])
    case entry
      let [outputs (transduce-key entry rule [])]
        match (get :container entry)
          case :object (transduce-begin state object-start outputs)
          case :array (transduce-begin state array-start outputs)
          case _ (transition state (transduce-scalar (get :scalar entry) rule outputs))

def transduce-close [spec state rule]
  match (get (get :name rule) spec)
    case missing (transition state [])
    case entry
      match (get :container entry)
        case :object (transduce-end spec state rule object-end)
        case :array (transduce-end spec state rule array-end)
        case _ (transition state (transduce-value (get :scalar entry) rule []))

def transduce-step [spec state pass]
  match pass
    case (open rule) (transduce-open spec state rule)
    case (close rule) (transduce-close spec state rule)

def transduce-finish [state]
  match state
    case [[] carry] []
    case _ (fail :protocol-order "the rule passes ended inside a container, which a tree's never do")

; The outputs with the member an open pass announces after what it
; begins or yields: its entry's `:member`, read as `:key` is.
def transduce-member [spec rule outputs]
  match (get (get :name rule) spec)
    case missing outputs
    case entry (transduce-named (get :member entry) rule outputs)

; The open texts with `more` written at the end of the innermost.
def transduce-write [texts more]
  push (string-join "" [(top texts) more]) (pop texts)

; The open texts with a pass's tokens written at the end of the
; innermost, each token's `:src` in order; as they were when no text is
; open, or the pass consumed no token.
def transduce-spell [texts rule]
  match texts
    case [] texts
    case _
      match (get :tokens rule)
        case [] texts
        case tokens (transduce-write texts (string-join "" (map (fn [token] (get :src token)) tokens)))

; The open texts after an open pass: its tokens written to the innermost,
; then, for a rule the spec names a `:text` rule, a text of its own.
def transduce-text-open [spec texts rule]
  let [spelled (transduce-spell texts rule)]
    match (get (get :name rule) spec)
      case missing spelled
      case entry
        match (get :text entry)
          case true (push "" spelled)
          case _ spelled

; A `:text` rule's text, closed: the texts around it, the innermost of
; which it joins before the close pass's own tokens do, and the scalar it
; yields.
def transduce-text-end [text texts rule]
  match texts
    case [] [texts [(scalar text)]]
    case _ [(transduce-spell (transduce-write texts text) rule) [(scalar text)]]

; A close pass's open texts, and the outputs it yields before any other:
; a `:text` rule's text, closed; for any other rule nothing, its tokens
; written to the innermost text.
def transduce-text-close [spec texts rule]
  match (get (get :name rule) spec)
    case missing [(transduce-spell texts rule) []]
    case entry
      match (get :text entry)
        case true (transduce-text-end (top texts) (pop texts) rule)
        case _ [(transduce-spell texts rule) []]

; `first`, then the outputs of a close pass, which are at most one.
def transduce-then [first outputs]
  match outputs
    case [] first
    case [output] (push output first)

; transduce-tree's step: transduce-step's over the tree's state, with the
; open texts beside it, an open pass's member after what it begins or
; yields, and a `:text` rule's text before what its close pass ends.
def transduce-pass [spec state pass]
  match state
    case [tree texts]
      match pass
        case (open rule)
          match (transduce-open spec tree rule)
            case (transition next outputs) (transition [next (transduce-text-open spec texts rule)] (transduce-member spec rule outputs))
        case (close rule)
          match (transduce-text-close spec texts rule)
            case [rest first]
              match (transduce-close spec tree rule)
                case (transition next outputs) (transition [next rest] (transduce-then first outputs))

def transduce-done [state]
  match state
    case [tree texts] (transduce-finish tree)

; A tree's JSON events from the rule passes, as `spec` says.
def transduce-tree [spec input]
  as-events (scan-emit [[[] false] []] (partial transduce-pass spec) transduce-done (parser-events input))

; The declarative records transducer: the JSON events of a document of
; records, each a sequence of cells, from a grammar's rule passes. That
; is the shape a delimited format's grammar reads, and transduce-tree
; cannot say it, since a record's members are named by the first
; record's cells. CSV's part is
;
;   def csv-transduce [input]
;     transduce-records
;       record
;         entry :document "csv"
;         entry :record "record"
;         entry :cell "val"
;         entry :empty "empty"
;         entry :header true
;         entry :unnamed "field~"
;       input
;
; The spec is a record of: `:document`, the rule whose open pass begins
; the document's array and whose close pass ends it (a document that
; makes no pass is the empty array); `:record`, the rule whose open pass
; begins a record and whose close pass ends it; `:cell`, the rule whose
; close pass's `:value` is the record's next cell (a close pass with no
; value is none); `:empty`, a group: a pass of any rule whose alternate
; is in it is an empty cell, which holds `:fill` (left out, no pass is);
; `:fill`, what an empty cell holds, and a header cell a record lacks
; (the empty string when it is left out); `:header`, whether the first
; record's cells name the columns; and `:unnamed`, the prefix of the name
; of a cell past them (the empty string when it is left out). With
; `:header` true, the first record is read for its names and makes no
; events, and each later record is an object: its cells keyed by the
; names in order, a cell past them by `:unnamed` and its position from
; 0, a name it lacks holding `:fill`. A name is its cell's text: a
; string as it is, null and a boolean as the words `null`, `true` and
; `false`, a number as `scalar-text` writes it; and a name the header
; repeats is announced as often, as the record spells it, so a tree's
; contract after the transducer refuses such a document. Left out or
; false, every record is an array
; of its cells. The rules the spec names are read first, then the
; `:empty` group: a pass of the `:cell` rule is a cell by its value
; whatever its alternate.
;
; The state is [phase names cells]: the phase (:before the document,
; :header, :row, :done), the header's names once read, and a marker per
; cell of the current record so far, so nothing grows with the
; document's length, only with a record's width, under
; max_metadata_bytes. A step's outputs are one vector, and a record's
; missing cells are as many pairs as the header has left, so the
; transducer is two scans: the first yields each cell as a vector, its
; name and its value or its value alone, and each container as a
; keyword, and the second writes each as its events.

; What an empty cell holds.
def transduce-records-fill [spec]
  match (get :fill spec)
    case missing ""
    case fill fill

; The prefix of the name of a cell past the header's.
def transduce-records-unnamed [spec]
  match (get :unnamed spec)
    case missing ""
    case prefix prefix

; Whether a pass's alternate is in the spec's `:empty` group.
def transduce-records-empty [spec rule]
  match [(get :empty spec) (get :alt rule)]
    case [missing _] false
    case [_ missing] false
    case [group alt]
      match (count (filter (fn [g] (equal g group)) (get :g alt)))
        case 0 false
        case _ true

; The name a header cell gives its column: its text.
def transduce-records-name [value]
  match (kind value)
    case :string value
    case :null "null"
    case :boolean
      match value
        case true "true"
        case _ "false"
    case _ (scalar-text (record) value)

; A cell: a header cell is kept as a name; a record's cell is yielded
; under the header's name at its position, or `:unnamed` and the
; position, or alone when there is no header.
def transduce-records-cell [spec value state]
  match state
    case [:header names cells] (transition [:header (push (transduce-records-name value) names) cells] [])
    case [:row names cells]
      match (get :header spec)
        case true
          let [n (count cells)]
            match (get-path (path n) names)
              case missing (transition [:row names (push true cells)] [[(string-join "" [(transduce-records-unnamed spec) (scalar-text (record) n)]) value]])
              case name (transition [:row names (push true cells)] [[name value]])
        case _ (transition [:row names (push true cells)] [[value]])
    case _ (transition state [])

; The header's names a record lacks, each with what an empty cell holds.
def transduce-records-fills [spec names cells]
  map (fn [j] [(get-path (path j) names) (transduce-records-fill spec)]) (filter (fn [j] (match (compare j (count cells)) (case :less false) (case _ true))) (indices names))

; The document begins: its array, then its header when the spec has one.
def transduce-records-begin [spec]
  match (get :header spec)
    case true (transition [:header [] []] [:array-start])
    case _ (transition [:row [] []] [:array-start])

; A record begins: an object when a header names the columns, an array
; otherwise; the header's own record begins nothing.
def transduce-records-record [spec state]
  match state
    case [:row names cells]
      match (get :header spec)
        case true (transition [:row names []] [:object-start])
        case _ (transition [:row names []] [:array-start])
    case _ (transition state [])

; A record ends: the header's goes on to the rows, and a row's object
; first takes the names it lacks.
def transduce-records-end [spec state]
  match state
    case [:header names cells] (transition [:row names []] [])
    case [:row names cells]
      match (get :header spec)
        case true (transition [:row names []] (push :object-end (transduce-records-fills spec names cells)))
        case _ (transition [:row names []] [:array-end])
    case _ (transition state [])

def transduce-records-open [spec state rule]
  let [name (get :name rule)]
    if (equal name (get :document spec))
      transduce-records-begin spec
      if (equal name (get :record spec))
        transduce-records-record spec state
        if (transduce-records-empty spec rule)
          transduce-records-cell spec (transduce-records-fill spec) state
          transition state []

def transduce-records-close [spec state rule]
  let [name (get :name rule)]
    if (equal name (get :cell spec))
      match (get :value rule)
        case missing (transition state [])
        case value (transduce-records-cell spec value state)
      if (equal name (get :record spec))
        transduce-records-end spec state
        if (equal name (get :document spec))
          transition [:done [] []] [:array-end]
          if (transduce-records-empty spec rule)
            transduce-records-cell spec (transduce-records-fill spec) state
            transition state []

def transduce-records-step [spec state pass]
  match pass
    case (open rule) (transduce-records-open spec state rule)
    case (close rule) (transduce-records-close spec state rule)

; A document that makes no pass is the empty array.
def transduce-records-finish [state]
  match state
    case [:before names cells] [:array-start :array-end]
    case [:done names cells] []
    case _ (fail :protocol-order "the rule passes ended inside the document, which a records grammar's never do")

; Each item of the first scan as its events.
def transduce-records-expand [state item]
  match item
    case :array-start (transition state [array-start])
    case :array-end (transition state [array-end])
    case :object-start (transition state [object-start])
    case :object-end (transition state [object-end])
    case [name value] (transition state [(key name) (scalar value)])
    case [value] (transition state [(scalar value)])

; The second scan ends with nothing more.
def transduce-records-flush [state]
  []

; A document's JSON events from the rule passes, as `spec` says.
def transduce-records [spec input]
  as-events (scan-emit [] transduce-records-expand transduce-records-flush (scan-emit [:before [] []] (partial transduce-records-step spec) transduce-records-finish (parser-events input)))
